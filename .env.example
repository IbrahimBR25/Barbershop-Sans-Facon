# Copier ce fichier en « .env.local » pour le développement.
# En production, saisir ces valeurs dans Vercel → Settings → Environment Variables.
# Ne JAMAIS committer de vraies valeurs.

# Connexion Postgres de Supabase.
# Supabase → Connect → « Transaction pooler » (port 6543).
DATABASE_URL=postgres://postgres.xxxxxxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# Les trois valeurs suivantes sont générées par : npm run hash-password
AUTH_SECRET=
ADMIN_PASSWORD_HASH=
CALENDAR_FEED_KEY=

# Adresse publique du site, sans « / » final.
NEXT_PUBLIC_SITE_URL=https://www.exemple.tn
